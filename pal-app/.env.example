# Set by the GitHub workflow when publishing (pal-app.yml). For running locally, put the same values in .env.
# Where Pal's server lives, e.g. https://pal-server-xxxx.a.run.app
EXPO_PUBLIC_API_URL=
# The app password (not an API key): `gcloud secrets versions access latest --secret pal-app-secret`
EXPO_PUBLIC_APP_SECRET=

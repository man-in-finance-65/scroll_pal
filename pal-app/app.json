{
  "expo": {
    "name": "Pal",
    "slug": "scroll-pal",
    "scheme": "pal",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": false, "bundleIdentifier": "app.scrollpal.pal" },
    "android": { "package": "app.scrollpal.pal" },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-image-picker", { "cameraPermission": "Pal looks at a photo of your pantry to see which staples you already have." }]
    ],
    "experiments": { "typedRoutes": false },
    "runtimeVersion": { "policy": "sdkVersion" },
    "extra": { "eas": { "projectId": "79b48e89-9dc9-4e6f-9e1a-183307fbc025" } }
  }
}

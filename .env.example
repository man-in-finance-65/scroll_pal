# ---- API (api/.env locally, Secret Manager / env vars on Cloud Run) ----
# Google AI Studio key for Gemini (reads the cooking video)
GEMINI_API_KEY=
# Anthropic key for Claude (builds the plan)
ANTHROPIC_API_KEY=
# 1 = return a fixed recipe/plan, no AI calls, zero spend
MOCK_AI=1
# Optional overrides
GEMINI_MODEL=gemini-flash-latest
CLAUDE_MODEL=claude-haiku-5-5
PORT=8080
# Live tracker: the id of the private Google Sheet (see DEPLOY.md). Leave empty to log only.
SHEET_ID=

# ---- App (app/.env) ----
# Where the phone finds the API. Local: http://<your-laptop-wifi-ip>:8080  Deployed: https://scrollpal-api-xxxx.run.app
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080

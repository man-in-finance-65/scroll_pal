# Copy this file to .env and fill in values. Never commit .env.
# The phone app never sees these; only the API and scripts read them.

# Gemini (Google AI Studio) - watches reels
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Price per 1M tokens for the model above, from Google's pricing page (used only for cost logging)
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=

# Anthropic (Claude) - reasoning, plan writing, profile extraction
ANTHROPIC_API_KEY=

# Apify - fetches reel media for URLs the user supplied
APIFY_TOKEN=
# Price per 1,000 results for apify/instagram-scraper (Free plan, Oct 2026). Used only for cost logging.
APIFY_PRICE_PER_1000=2.70

# USDA FoodData Central - nutrient values
USDA_API_KEY=

# Clerk - sign-in
CLERK_SECRET_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Phone app settings. EXPO_PUBLIC_ values are bundled into the app, so never put a secret here.
# Copy these two lines into app/.env as well.
# Local testing: http://<your laptop's Wi-Fi IP>:8080 ; later the Cloud Run URL
EXPO_PUBLIC_API_URL=

# SurrealDB Cloud
SURREAL_URL=
SURREAL_NAMESPACE=
SURREAL_DATABASE=
SURREAL_USER=
SURREAL_PASS=
# Optional instead of user/pass: a database access token
SURREAL_TOKEN=
# yes / no, set during Gate 0
SURREAL_AGENT_MEMORY=no

# Google Cloud (Cloud Run deploy)
GCP_PROJECT_ID=
GCP_REGION=us-central1

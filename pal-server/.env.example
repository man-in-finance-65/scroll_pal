# Copy to .env (never commit .env). On Cloud Run these are set by scripts/deploy-pal-server.sh.
# Shared password between the app and this server. Any random string, 16+ characters.
APP_SECRET=
ANTHROPIC_API_KEY=
# Whisper speech-to-text
OPENAI_API_KEY=
# USDA FoodData Central (free key: https://fdc.nal.usda.gov/api-key-signup)
USDA_API_KEY=
# Optional: Instacart Developer Platform production key. Without it the cart opens Instacart.ca search.
INSTACART_API_KEY=
# Optional: contents of a Netscape cookies.txt, if Instagram/YouTube block the server.
YTDLP_COOKIES=
CLAUDE_MODEL=claude-sonnet-5-5
PORT=3000
